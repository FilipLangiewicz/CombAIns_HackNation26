# Secrets: the Kaggle tokens and the API keys.
.kaggle/
.env
.env.*
!.env.example

# Local environment and tools
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.claude/
CLAUDE.local.md
.vscode/
.idea/

# Windows metadata files from a copy into WSL
*:Zone.Identifier

# The data of the organizer (clone it, see CLAUDE.md)
data/uzp/
data/cache/

# Kaggle job outputs: keep only small files in git
**/jobs/runs/*/output/**/*.npy
**/jobs/runs/*/output/**/*.npz
**/jobs/runs/*/output/**/*.log
*.pt
*.zip

# The input and output folders of the application: keep only the folders
input/*
!input/.gitkeep
output/*
!output/.gitkeep

# The tools and the temporary files of the presentation
docs/presentation/node_modules/
docs/presentation/preview/
docs/presentation/deck.html
docs/presentation/layout.json
docs/presentation/deck.pdf
docs/presentation/deck.pptx
